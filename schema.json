{
  "$schema": "http://json-schema.org",
  "type": "object",
  "required": ["lastName", "firstName", "middleName", "course", "group", "sessions"],
  "additionalProperties": false,
  "properties": {
    "lastName": { "type": "string", "minLength": 1 },
    "firstName": { "type": "string", "minLength": 1 },
    "middleName": { "type": "string", "minLength": 1 },
    "course": { "type": "integer", "minimum": 1, "maximum": 6 },
    "group": { "type": "string", "minLength": 1 },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sessionNumber", "items"],
        "properties": {
          "sessionNumber": { "type": "integer", "minimum": 1, "maximum": 12 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["subject", "exam", "grade"],
              "properties": {
                "subject": { "type": "string", "minLength": 1 },
                "exam": { "type": "boolean" },
                "grade": { "type": "integer", "minimum": 0, "maximum": 10 }
              }
            }
          }
        }
      }
    }
  }
}
